# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_API_TOKEN=your_hubspot_private_app_token_here

# Comma-separated reo.dev AE emails — only these owners appear in Owner? column
# Leave blank to show all deal owners (not recommended)
HUBSPOT_AE_EMAILS=ae1@reo.dev,ae2@reo.dev

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to the service account JSON credentials file
GOOGLE_CREDENTIALS_FILE=/Users/rashuraj/trial-active-tenants/credentials.json

# "Sales Pipeline - 2026 - Sync Test" sheet ID (from URL: /spreadsheets/d/<ID>/)
PIPELINE_SHEET_ID=your_pipeline_sheet_id_here

# Tab name inside the pipeline sheet
PIPELINE_TAB_NAME=Sales Pipeline 2026

# "Weekly Meetings Booked update" sheet ID
SOURCE_SHEET_ID=your_weekly_meetings_sheet_id_here

# ── Slack ─────────────────────────────────────────────────────────────────────
# Kaori bot token + target channel ID for sync alerts
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_ALERT_CHANNEL=C0XXXXXXXXX

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8008
LOG_LEVEL=INFO

# Set to true only when deploying to VM and ready to run on schedule
SCHEDULER_ENABLED=false

# Set to true to enable Google OIDC auth wall on dashboard (off by default)
AUTH_ENABLED=false

# Allowed Google accounts for dashboard (comma-separated, only used when AUTH_ENABLED=true)
ALLOWED_EMAILS=rashu@reo.dev
