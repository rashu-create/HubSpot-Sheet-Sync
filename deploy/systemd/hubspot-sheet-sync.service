[Unit]
Description=HubSpot Sheet Sync
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/services/hubspot-sheet-sync
EnvironmentFile=/opt/services/hubspot-sheet-sync/.env
ExecStart=/opt/services/hubspot-sheet-sync/.venv/bin/uvicorn src.api:app --host 127.0.0.1 --port 8008
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
